{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "process",
			"command": "cargo",
			"args": [
				"run",
				"--",
				"build",
				"--backend=llvm",
				"-i=data/test.storm",
				"-o=out/test.out",
				"--show-all"
			],
			"problemMatcher": [
				"$rustc"
			],
			"options": {
				"env": {
					"RUST_BACKTRACE": "1"
				}
			},
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"label": "rust: cargo run",
			"presentation": {
				"clear": true
			}
		}
	]
}
